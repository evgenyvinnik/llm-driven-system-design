{
  "name": "settings-service-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Settings service: setting definitions, org policy with enforcement, per-key PATCH with revision-based conflict detection, validation with a deprecation grace window, and SSE change notifications fanned out across instances through Valkey pub/sub",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api-a,api-b -c blue,magenta \"npm run dev:a\" \"npm run dev:b\"",
    "dev:a": "INSTANCE_ID=${INSTANCE_ID_A:-api-a} PORT=${PORT_A:-3000} tsx watch src/api/index.ts",
    "dev:b": "INSTANCE_ID=${INSTANCE_ID_B:-api-b} PORT=${PORT_B:-3001} tsx watch src/api/index.ts",
    "dev:server1": "INSTANCE_ID=api-1 PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "INSTANCE_ID=api-2 PORT=3002 tsx watch src/api/index.ts",
    "dev:server3": "INSTANCE_ID=api-3 PORT=3003 tsx watch src/api/index.ts",
    "start": "tsx src/api/index.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "ioredis": "^5.8.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
