{
  "name": "collaborative-editor",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "collaborative_editor",
  "dbUser": "collab",
  "auth": {
    "enabled": false
  },
  "screens": [
    {
      "name": "01-document-list",
      "path": "/",
      "waitFor": "[data-testid='document-item']",
      "delay": 1500
    },
    {
      "name": "02-editor",
      "path": "/",
      "waitFor": "[data-testid='document-item']",
      "click": "[data-testid='document-item']",
      "clickDelay": 2500,
      "delay": 1000
    },
    {
      "name": "03-editor-postmortem",
      "path": "/",
      "waitFor": "[data-testid='document-item']",
      "click": "[data-testid='document-item']:has-text('Incident Postmortem')",
      "clickDelay": 2500,
      "delay": 1000
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
