{
  "name": "typeahead",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "typeahead",
  "dbUser": "typeahead",
  "auth": {
    "enabled": false
  },
  "screens": [
    {
      "name": "01-home",
      "path": "/",
      "delay": 1500
    },
    {
      "name": "02-suggestions",
      "path": "/",
      "delay": 1200,
      "fill": {
        "input[placeholder='Start typing to search...']": "how to"
      },
      "fillDelay": 2000
    },
    {
      "name": "03-suggestions-weather",
      "path": "/",
      "delay": 1200,
      "fill": {
        "input[placeholder='Start typing to search...']": "weat"
      },
      "fillDelay": 2000
    },
    {
      "name": "04-admin-overview",
      "path": "/admin",
      "delay": 2200
    },
    {
      "name": "05-admin-analytics",
      "path": "/admin",
      "delay": 1500,
      "click": [
        "button:has-text('Analytics')"
      ],
      "clickDelay": 2200
    },
    {
      "name": "06-admin-management",
      "path": "/admin",
      "delay": 1500,
      "click": [
        "button:has-text('Management')"
      ],
      "clickDelay": 2200
    },
    {
      "name": "07-widgets",
      "path": "/widgets",
      "delay": 1500,
      "waitFor": "h1"
    },
    {
      "name": "08-home-full-client-performance",
      "path": "/",
      "delay": 1200,
      "fill": {
        "input[placeholder='Start typing to search...']": "react"
      },
      "fillDelay": 2000,
      "fullPage": true
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
