{
  "name": "doordash",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "doordash",
  "dbUser": "doordash",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "email": "customer@example.com",
      "password": "password123"
    },
    "usernameSelector": "input[name='email'], input[type='email']",
    "passwordSelector": "input[name='password'], input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "skipAuth": true,
      "waitFor": "form",
      "delay": 500
    },
    {
      "name": "02-home",
      "path": "/",
      "waitFor": "main",
      "delay": 1200
    },
    {
      "name": "03-restaurant-menu",
      "path": "/restaurant/1",
      "waitFor": "main",
      "delay": 1200
    },
    {
      "name": "04-orders",
      "path": "/orders",
      "waitFor": "main",
      "delay": 1200
    },
    {
      "name": "05-driver-dashboard",
      "path": "/driver-dashboard",
      "waitFor": "main",
      "delay": 1500,
      "loginAs": {
        "email": "driver@example.com",
        "password": "password123"
      }
    },
    {
      "name": "06-restaurant-dashboard",
      "path": "/restaurant-dashboard",
      "waitFor": "main",
      "delay": 1500,
      "loginAs": {
        "email": "restaurant@example.com",
        "password": "password123"
      }
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
