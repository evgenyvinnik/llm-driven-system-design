{
  "name": "slack",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "slack",
  "dbUser": "slack",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "email": "alice@company.com",
      "password": "password123"
    },
    "usernameSelector": "input[name='email'], input[type='email']",
    "passwordSelector": "input[name='password'], input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main, aside, [data-testid='workspace']"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "02-workspace-select",
      "path": "/workspace-select",
      "waitFor": "main",
      "delay": 1000
    },
    {
      "name": "03-workspace",
      "path": "/",
      "waitFor": "main, aside",
      "delay": 2000
    },
    {
      "name": "04-channel-general",
      "path": "/",
      "delay": 1800,
      "click": ["text=general"],
      "clickDelay": 2000
    },
    {
      "name": "05-thread",
      "path": "/",
      "delay": 1800,
      "click": ["text=general", "button:has-text('replies')"],
      "clickDelay": 2000
    },
    {
      "name": "06-search",
      "path": "/",
      "delay": 1800,
      "click": ["button:has-text('Search messages')"],
      "clickDelay": 900,
      "fill": { "input[placeholder='Search messages...']": "design system" },
      "fillDelay": 500,
      "pressEnter": "input[placeholder='Search messages...']",
      "pressEnterDelay": 2200
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
