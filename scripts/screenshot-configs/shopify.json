{
  "name": "shopify",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "shopify",
  "dbUser": "shopify",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "email": "merchant@example.com",
      "password": "password123"
    },
    "usernameSelector": "input[name='email'], input[type='email']",
    "passwordSelector": "input[name='password'], input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "skipAuth": true,
      "waitFor": "form",
      "delay": 600
    },
    {
      "name": "02-merchant-stores",
      "path": "/",
      "delay": 2200
    },
    {
      "name": "03-storefront",
      "path": "/store/demo",
      "delay": 2500
    },
    {
      "name": "04-merchant-dashboard",
      "path": "/admin/1",
      "delay": 2600
    },
    {
      "name": "05-merchant-products",
      "path": "/admin/1",
      "delay": 1200,
      "click": ["button:has-text('Products')"],
      "clickDelay": 1800
    },
    {
      "name": "06-merchant-orders",
      "path": "/admin/1",
      "delay": 1200,
      "click": ["button:has-text('Orders')"],
      "clickDelay": 1800
    },
    {
      "name": "07-merchant-customers",
      "path": "/admin/1",
      "delay": 1200,
      "click": ["button:has-text('Customers')"],
      "clickDelay": 1800
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
