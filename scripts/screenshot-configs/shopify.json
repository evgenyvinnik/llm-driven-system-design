{
  "name": "shopify",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "shopify",
  "dbUser": "shopify",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "email": "merchant@example.com",
      "password": "password123"
    },
    "usernameSelector": "input[name='email'], input[type='email']",
    "passwordSelector": "input[name='password'], input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "skipAuth": true,
      "waitFor": "form",
      "delay": 600
    },
    {
      "name": "02-merchant-stores",
      "path": "/",
      "delay": 2200
    },
    {
      "name": "03-storefront",
      "path": "/store/demo",
      "delay": 2500
    },
    {
      "name": "04-platform-admin",
      "path": "/admin",
      "delay": 2200,
      "loginAs": {
        "email": "admin@shopify-demo.local",
        "password": "password123"
      }
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
