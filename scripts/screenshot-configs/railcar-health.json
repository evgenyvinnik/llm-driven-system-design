{
  "name": "railcar-health",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "railcar_health",
  "dbUser": "railcar",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": { "username": "carol", "password": "password123" },
    "usernameSelector": "input[name='username']",
    "passwordSelector": "input[name='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    { "name": "01-login", "path": "/login", "waitFor": "form", "skipAuth": true, "delay": 500 },
    { "name": "02-alerts", "path": "/alerts", "waitFor": "ul[aria-label='Alerts']", "delay": 800 },
    { "name": "04-car-trend", "path": "/cars/NRLX%20304512?position=R3", "waitFor": "main", "delay": 1000 },
    { "name": "05-yard-inspection", "path": "/yard", "waitFor": "main", "delay": 1000 },
    { "name": "06-detectors", "path": "/detectors", "waitFor": "table[aria-label='Detectors']", "delay": 800 },
    { "name": "07-reliability", "path": "/admin", "waitFor": "text=Precision by tier", "delay": 1000 },
    { "name": "08-car-event-timeline", "path": "/timeline?car=NRLX%20304512", "waitFor": "ol[aria-label='Event timeline']", "delay": 1200 },
    { "name": "10-ops-streams", "path": "/ops", "waitFor": "table[aria-label='Consumer groups']", "delay": 1500 }
  ],
  "viewport": { "width": 1440, "height": 900 }
}
