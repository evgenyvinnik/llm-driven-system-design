{
  "name": "confluence",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "confluence",
  "dbUser": "confluence",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "username": "alice",
      "password": "password123"
    },
    "usernameSelector": "input#username",
    "passwordSelector": "input#password",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login-page",
      "path": "/login",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "02-dashboard",
      "path": "/",
      "waitFor": "main, h1",
      "delay": 1000
    },
    {
      "name": "03-space-view",
      "path": "/space/ENG",
      "waitFor": "main, h1",
      "delay": 1000
    },
    {
      "name": "04-page-view",
      "path": "/space/ENG/page/getting-started",
      "waitFor": "main, h1",
      "delay": 1500
    },
    {
      "name": "05-draft-under-review",
      "path": "/space/ENG/page/q3-platform-migration-plan",
      "waitFor": "[data-testid='draft-badge']",
      "delay": 1500
    },
    {
      "name": "06-search-results",
      "path": "/?q=signing%20keys",
      "waitFor": "main h1",
      "delay": 2500
    },
    {
      "name": "07-viewer-space",
      "path": "/space/ENG",
      "waitFor": "[data-testid='view-only-space']",
      "delay": 1500,
      "loginAs": {
        "username": "carol",
        "password": "password123"
      }
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
