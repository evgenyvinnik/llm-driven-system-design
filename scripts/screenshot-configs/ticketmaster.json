{
  "name": "ticketmaster",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "ticketmaster",
  "dbUser": "ticketmaster",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "email": "admin@ticketmaster.local",
      "password": "password123"
    },
    "usernameSelector": "input[name='email'], input[type='email']",
    "passwordSelector": "input[name='password'], input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "02-home",
      "path": "/",
      "waitFor": "main",
      "delay": 1500
    },
    {
      "name": "03-orders",
      "path": "/orders",
      "waitFor": "main",
      "delay": 500
    },
    {
      "name": "04-seat-map",
      "path": "/",
      "delay": 2000,
      "click": [
        "a[href^='/events/'] >> nth=1"
      ],
      "clickDelay": 3000
    },
    {
      "name": "05-seat-selected",
      "path": "/",
      "delay": 2000,
      "click": [
        "a[href^='/events/'] >> nth=1",
        "text=Block A1",
        "button[title^='Row'] >> nth=4"
      ],
      "clickDelay": 2000,
      "fullPage": true
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}