{
  "name": "netflix",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "netflix",
  "dbUser": "netflix",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "email": "demo@netflix.local",
      "password": "password123"
    },
    "usernameSelector": "input[name='email'], input[type='email']",
    "passwordSelector": "input[name='password'], input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "[data-testid='profiles'], .profiles, main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "skipAuth": true,
      "waitFor": "form",
      "delay": 600
    },
    {
      "name": "02-profiles",
      "path": "/profiles",
      "waitFor": "[data-testid='profile-tile']",
      "delay": 1200
    },
    {
      "name": "03-browse",
      "path": "/profiles",
      "waitFor": "[data-testid='profile-tile']",
      "delay": 1000,
      "click": "[data-testid='profile-tile']",
      "clickDelay": 2800
    },
    {
      "name": "04-series",
      "path": "/browse/series",
      "delay": 2200
    },
    {
      "name": "05-movies",
      "path": "/browse/movies",
      "delay": 2200
    },
    {
      "name": "06-title-detail",
      "path": "/video/c0000000-0000-0000-0000-000000000010",
      "delay": 2200
    },
    {
      "name": "07-search",
      "path": "/search?q=the",
      "delay": 2200
    },
    {
      "name": "08-my-list",
      "path": "/my-list",
      "delay": 2000
    },
    {
      "name": "09-watch",
      "path": "/watch/c0000000-0000-0000-0000-000000000001",
      "delay": 2500
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
