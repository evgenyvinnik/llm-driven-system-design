{
  "name": "salesforce",
  "frontendPort": 5173,
  "backendPort": 3001,
  "backendRequired": true,
  "dbName": "salesforce",
  "dbUser": "salesforce",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "username": "alice",
      "password": "password123"
    },
    "usernameSelector": "input[name='username']",
    "passwordSelector": "input[name='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "nav, aside"
  },
  "screens": [
    {
      "name": "01-login-page",
      "path": "/login",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "02-dashboard",
      "path": "/",
      "waitFor": "main h1",
      "delay": 1000
    },
    {
      "name": "03-leads",
      "path": "/leads",
      "waitFor": "main, h1",
      "delay": 1000
    },
    {
      "name": "04-accounts",
      "path": "/accounts",
      "waitFor": "main, h1",
      "delay": 1000
    },
    {
      "name": "05-contacts",
      "path": "/contacts",
      "waitFor": "main, h1",
      "delay": 1000
    },
    {
      "name": "06-opportunities",
      "path": "/opportunities",
      "waitFor": "main, h1",
      "delay": 1000
    },
    {
      "name": "07-reports",
      "path": "/reports",
      "waitFor": "main, h1",
      "delay": 1000
    },
    {
      "name": "08-account-detail",
      "path": "/accounts/acc00001-0000-0000-0000-000000000001",
      "waitFor": "h2",
      "delay": 1000
    },
    {
      "name": "09-account-opportunities",
      "path": "/accounts/acc00002-0000-0000-0000-000000000002",
      "waitFor": "h2",
      "click": "nav button:has-text('Opportunities')",
      "delay": 800
    },
    {
      "name": "10-new-opportunity",
      "path": "/opportunities",
      "waitFor": "main h2",
      "click": "button:has-text('New Opportunity')",
      "delay": 800
    },
    {
      "name": "11-pipeline-closed-columns",
      "path": "/opportunities",
      "waitFor": "main h2",
      "click": "h3:has-text('Closed Lost')",
      "delay": 800
    },
    {
      "name": "12-rep-opportunities",
      "path": "/opportunities",
      "waitFor": "main h2",
      "loginAs": {
        "username": "bob",
        "password": "password123"
      },
      "delay": 1000
    },
    {
      "name": "13-rep-reports",
      "path": "/reports",
      "waitFor": "[data-testid='report-scope']",
      "loginAs": {
        "username": "bob",
        "password": "password123"
      },
      "delay": 1000
    },
    {
      "name": "14-rep-hidden-account",
      "path": "/accounts/acc00001-0000-0000-0000-000000000001",
      "waitFor": "main",
      "loginAs": {
        "username": "bob",
        "password": "password123"
      },
      "delay": 1000
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
