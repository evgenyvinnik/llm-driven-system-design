{
  "name": "zoom",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "zoom",
  "dbUser": "zoom",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "username": "alice",
      "password": "password123"
    },
    "usernameSelector": "input[type='text']",
    "passwordSelector": "input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 600
    },
    {
      "name": "02-dashboard",
      "path": "/",
      "waitFor": "main",
      "delay": 1500
    },
    {
      "name": "03-schedule",
      "path": "/schedule",
      "waitFor": "main",
      "delay": 1200
    },
    {
      "name": "04-history",
      "path": "/history",
      "waitFor": "main",
      "delay": 1500
    },
    {
      "name": "05-meeting-lobby",
      "path": "/meeting/abc-defg-hij",
      "waitFor": "main",
      "delay": 2500
    },
    {
      "name": "06-in-meeting",
      "path": "/meeting/abc-defg-hij",
      "waitFor": "button:has-text('Join Meeting')",
      "delay": 2500,
      "steps": [
        {
          "click": "button:has-text('Join Meeting')",
          "delay": 4000
        }
      ]
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}