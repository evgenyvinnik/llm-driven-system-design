{
  "name": "scalable-api",
  "frontendPort": 5173,
  "backendPort": 8080,
  "backendRequired": true,
  "dbName": "scalable_api",
  "dbUser": "postgres",
  "auth": {
    "enabled": true,
    "loginUrl": "/",
    "credentials": {
      "email": "alice@example.com",
      "password": "password123"
    },
    "usernameSelector": "input[name='email'], input#email",
    "passwordSelector": "input[name='password'], input#password",
    "submitSelector": "button[type='submit']",
    "successIndicator": "header, main"
  },
  "screens": [
    {
      "name": "01-login-page",
      "path": "/",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "02-dashboard",
      "path": "/",
      "waitFor": "header, main",
      "delay": 1500
    },
    {
      "name": "03-cache-populated",
      "path": "/",
      "delay": 2000,
      "click": [
        "[data-testid='action-fetchResources']",
        "[data-testid='action-fetchResources']",
        "[data-testid='action-fetchResources']"
      ],
      "clickDelay": 900
    },
    {
      "name": "04-circuit-breaker",
      "path": "/",
      "delay": 2000,
      "click": [
        "[data-testid='action-testExternal']",
        "[data-testid='action-testExternal']",
        "[data-testid='action-testExternal']",
        "[data-testid='action-testExternal']"
      ],
      "clickDelay": 900
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
