{
  "name": "fb-post-search",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "fb_post_search",
  "dbUser": "fb_search",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "username": "alice",
      "password": "password123"
    },
    "usernameSelector": "input[name='username'], #username",
    "passwordSelector": "input[name='password'], #password",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "02-register",
      "path": "/register",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "03-home",
      "path": "/",
      "waitFor": "main",
      "delay": 1000
    },
    {
      "name": "04-search-results",
      "path": "/",
      "delay": 1800,
      "fill": {
        "input[placeholder='Search posts...']": "code"
      },
      "pressEnter": "input[placeholder='Search posts...']",
      "pressEnterDelay": 7000
    },
    {
      "name": "05-hashtag-search",
      "path": "/",
      "delay": 1500,
      "fill": {
        "input[placeholder='Search posts...']": "#programming"
      },
      "pressEnter": "input[placeholder='Search posts...']",
      "pressEnterDelay": 7000
    },
    {
      "name": "06-admin",
      "path": "/admin",
      "delay": 2200
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
