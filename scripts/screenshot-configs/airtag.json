{
  "name": "airtag",
  "frontendPort": 5173,
  "backendPort": 3000,
  "backendRequired": true,
  "dbName": "findmy",
  "dbUser": "findmy",
  "auth": {
    "enabled": true,
    "loginUrl": "/",
    "credentials": {
      "email": "admin@findmy.local",
      "password": "password123"
    },
    "usernameSelector": "input[type='email']",
    "passwordSelector": "input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main, header"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/",
      "skipAuth": true,
      "waitFor": "form",
      "delay": 600
    },
    {
      "name": "02-home-devices",
      "path": "/",
      "waitFor": "main",
      "delay": 2500
    },
    {
      "name": "03-device-map",
      "path": "/",
      "waitFor": "main",
      "click": "[data-testid='device-card']",
      "clickDelay": 2500,
      "delay": 2500
    },
    {
      "name": "04-notifications",
      "path": "/",
      "waitFor": "main",
      "click": "header button",
      "clickDelay": 1200,
      "delay": 2500
    },
    {
      "name": "05-admin-dashboard",
      "path": "/",
      "waitFor": "main",
      "click": "button:has-text('Admin Dashboard')",
      "clickDelay": 2000,
      "delay": 2500
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
