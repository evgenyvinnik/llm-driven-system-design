{
  "name": "docusign",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "docusign",
  "dbUser": "docusign",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "email": "admin@docusign.local",
      "password": "password123"
    },
    "usernameSelector": "input[name='email'], input[type='email']",
    "passwordSelector": "input[name='password'], input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "02-dashboard",
      "path": "/",
      "waitFor": "main",
      "delay": 1200
    },
    {
      "name": "03-envelopes",
      "path": "/envelopes",
      "waitFor": "main",
      "delay": 1200
    },
    {
      "name": "04-signing-ceremony",
      "path": "/sign/sign-nda-alice-0000000000000001",
      "waitFor": ".field-highlight, main",
      "skipAuth": true,
      "delay": 2500
    },
    {
      "name": "05-signature-modal",
      "path": "/sign/sign-nda-alice-0000000000000001",
      "waitFor": ".field-highlight, main",
      "skipAuth": true,
      "click": ".field-highlight.signature",
      "clickDelay": 1500,
      "delay": 800
    },
    {
      "name": "06-admin",
      "path": "/admin",
      "waitFor": "main",
      "delay": 800
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
