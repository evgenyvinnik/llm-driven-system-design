{
  "name": "price-tracking",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "pricetracker",
  "dbUser": "pricetracker",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "email": "admin@pricetracker.local",
      "password": "password123"
    },
    "usernameSelector": "input[name='email'], input[type='email']",
    "passwordSelector": "input[name='password'], input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "02-home",
      "path": "/",
      "waitFor": "main",
      "delay": 1500
    },
    {
      "name": "03-alerts",
      "path": "/alerts",
      "waitFor": "main",
      "delay": 500
    },
    {
      "name": "04-admin",
      "path": "/admin",
      "waitFor": "main",
      "delay": 500
    },
    {
      "name": "05-product-detail",
      "path": "/products/d0000000-0000-4000-8000-000000000001",
      "delay": 3000
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
