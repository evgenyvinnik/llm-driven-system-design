{
  "name": "notion",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "notion_db",
  "dbUser": "notion",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "email": "admin@notion.local",
      "password": "password123"
    },
    "usernameSelector": "input[name='email'], input[type='email']",
    "passwordSelector": "input[name='password'], input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "skipAuth": true,
      "waitFor": "form",
      "delay": 600
    },
    {
      "name": "02-home",
      "path": "/",
      "delay": 2500
    },
    {
      "name": "03-page-editor",
      "path": "/page/00000000-0000-0000-0000-000000000002",
      "delay": 2500
    },
    {
      "name": "04-database-table",
      "path": "/page/00000000-0000-0000-0000-000000000003",
      "delay": 2500
    },
    {
      "name": "05-database-board",
      "path": "/page/00000000-0000-0000-0000-000000000003",
      "delay": 2000,
      "click": "[data-testid='view-tab-board']",
      "clickDelay": 1800
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
