{
  "name": "uber",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "uber_db",
  "dbUser": "uber",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "email": "rider1@test.com",
      "password": "password123"
    },
    "usernameSelector": "input[name='email'], input[type='email']",
    "passwordSelector": "input[name='password'], input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "02-rider",
      "path": "/rider",
      "waitFor": "main",
      "delay": 1200
    },
    {
      "name": "03-fare-estimates",
      "path": "/rider",
      "waitFor": "#pickup-address",
      "delay": 1200,
      "steps": [
        {
          "fill": "#pickup-address",
          "value": "1 Market St, San Francisco"
        },
        {
          "click": "[data-testid='set-pickup']"
        },
        {
          "fill": "#dropoff-address",
          "value": "Fisherman's Wharf, San Francisco"
        },
        {
          "click": "[data-testid='set-dropoff']",
          "delay": 2000
        }
      ]
    },
    {
      "name": "04-rider-history",
      "path": "/rider/history",
      "waitFor": "main",
      "delay": 1200
    },
    {
      "name": "05-driver",
      "path": "/driver",
      "waitFor": "main",
      "delay": 1500,
      "loginAs": {
        "email": "driver1@test.com",
        "password": "password123"
      }
    },
    {
      "name": "06-driver-earnings",
      "path": "/driver/earnings",
      "waitFor": "main",
      "delay": 1500,
      "loginAs": {
        "email": "driver1@test.com",
        "password": "password123"
      }
    },
    {
      "name": "07-driver-history",
      "path": "/driver/history",
      "waitFor": "main",
      "delay": 1200,
      "loginAs": {
        "email": "driver1@test.com",
        "password": "password123"
      }
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}