{
  "name": "strava",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "strava",
  "dbUser": "strava",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "email": "alice@example.com",
      "password": "password123"
    },
    "usernameSelector": "input[name='email'], input[type='email']",
    "passwordSelector": "input[name='password'], input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "02-feed",
      "path": "/",
      "waitFor": "main",
      "delay": 1500
    },
    {
      "name": "03-explore",
      "path": "/explore",
      "waitFor": "main",
      "delay": 500
    },
    {
      "name": "04-activity-detail",
      "path": "/",
      "delay": 1500,
      "click": [
        "a[href^='/activity/'] >> nth=0"
      ],
      "clickDelay": 3000
    },
    {
      "name": "05-segments",
      "path": "/segments",
      "delay": 2000
    },
    {
      "name": "06-segment-leaderboard",
      "path": "/segments",
      "delay": 1500,
      "click": [
        "a[href^='/segment/'] >> nth=0"
      ],
      "clickDelay": 2500
    },
    {
      "name": "07-stats",
      "path": "/stats",
      "delay": 2200
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}