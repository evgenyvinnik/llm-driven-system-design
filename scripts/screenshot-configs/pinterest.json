{
  "name": "pinterest",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "pinterest",
  "dbUser": "pinterest",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "username": "alice",
      "password": "password123"
    },
    "usernameSelector": "input[name=\"username\"]",
    "passwordSelector": "input[name=\"password\"]",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "02-register",
      "path": "/register",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "03-home-feed",
      "path": "/",
      "waitFor": "main",
      "delay": 2000
    },
    {
      "name": "04-create-pin",
      "path": "/create",
      "waitFor": "main",
      "delay": 1000
    },
    {
      "name": "05-profile-alice",
      "path": "/profile/alice",
      "waitFor": "main",
      "delay": 1500
    },
    {
      "name": "06-pin-detail",
      "path": "/pin/0000f001-0000-0000-0000-000000000001",
      "delay": 2500
    },
    {
      "name": "07-board",
      "path": "/board/0000b001-0000-0000-0000-000000000001",
      "delay": 2500
    },
    {
      "name": "08-profile-saved",
      "path": "/profile/alice",
      "delay": 2000,
      "click": "button:has-text('Saved')",
      "clickDelay": 1800
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
