{
  "name": "etsy",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "etsy_db",
  "dbUser": "etsy",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "email": "buyer@example.com",
      "password": "password123"
    },
    "usernameSelector": "input[name='email'], input[type='email']",
    "passwordSelector": "input[name='password'], input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "skipAuth": true,
      "waitFor": "form",
      "delay": 500
    },
    {
      "name": "02-home",
      "path": "/",
      "waitFor": "main, h1",
      "delay": 1500
    },
    {
      "name": "03-cart",
      "path": "/cart",
      "waitFor": "main, h1",
      "delay": 1200
    },
    {
      "name": "04-favorites",
      "path": "/favorites",
      "waitFor": "main, h1",
      "delay": 1200
    },
    {
      "name": "05-orders",
      "path": "/orders",
      "waitFor": "main, h1",
      "delay": 1200
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
