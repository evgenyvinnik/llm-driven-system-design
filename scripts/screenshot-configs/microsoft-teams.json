{
  "name": "microsoft-teams",
  "frontendPort": 5173,
  "backendRequired": true,
  "dbName": "teams",
  "dbUser": "teams",
  "auth": {
    "enabled": true,
    "loginUrl": "/login",
    "credentials": {
      "username": "alice",
      "password": "password123"
    },
    "usernameSelector": "input[type='text']",
    "passwordSelector": "input[type='password']",
    "submitSelector": "button[type='submit']",
    "successIndicator": "main"
  },
  "screens": [
    {
      "name": "01-login",
      "path": "/login",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "02-register",
      "path": "/register",
      "waitFor": "form",
      "skipAuth": true,
      "delay": 500
    },
    {
      "name": "03-home",
      "path": "/",
      "delay": 2500
    },
    {
      "name": "04-general-channel",
      "path": "/org/aaaaaaaa-0000-0000-0000-000000000001/team/bbbbbbbb-0000-0000-0000-000000000001/channel/cccccccc-0000-0000-0000-000000000001",
      "delay": 2500
    },
    {
      "name": "05-deployments-channel",
      "path": "/org/aaaaaaaa-0000-0000-0000-000000000001/team/bbbbbbbb-0000-0000-0000-000000000001/channel/cccccccc-0000-0000-0000-000000000002",
      "delay": 2500
    },
    {
      "name": "06-thread-panel",
      "path": "/org/aaaaaaaa-0000-0000-0000-000000000001/team/bbbbbbbb-0000-0000-0000-000000000001/channel/cccccccc-0000-0000-0000-000000000002",
      "delay": 2200,
      "click": "[data-testid='thread-open']",
      "clickDelay": 1500
    },
    {
      "name": "07-member-list",
      "path": "/org/aaaaaaaa-0000-0000-0000-000000000001/team/bbbbbbbb-0000-0000-0000-000000000001/channel/cccccccc-0000-0000-0000-000000000001",
      "delay": 2200,
      "click": "[data-testid='toggle-members']",
      "clickDelay": 1500
    },
    {
      "name": "08-org-list",
      "path": "/org",
      "delay": 2000
    },
    {
      "name": "09-design-team",
      "path": "/org/aaaaaaaa-0000-0000-0000-000000000001/team/bbbbbbbb-0000-0000-0000-000000000002/channel/cccccccc-0000-0000-0000-000000000003",
      "delay": 2500
    },
    {
      "name": "10-create-channel",
      "path": "/org/aaaaaaaa-0000-0000-0000-000000000001/team/bbbbbbbb-0000-0000-0000-000000000001/channel/cccccccc-0000-0000-0000-000000000001",
      "delay": 2200,
      "click": "[data-testid='create-channel']",
      "clickDelay": 1200
    }
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  }
}
