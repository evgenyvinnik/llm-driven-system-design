{
  "name": "storage-remediation-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Storage misconfiguration remediation: inventory scanner, control evaluation, usage-evidence impact analysis, and a wave-based executor with throttling, bake-time verification and auto-rollback, against a simulated cloud control plane",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n sim,api,scanner,executor -c yellow,blue,green,magenta \"npm run dev:sim\" \"npm run dev:api\" \"npm run dev:scanner\" \"npm run dev:executor\"",
    "dev:sim": "tsx watch src/cloud-sim/index.ts",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:scanner": "tsx watch src/scanner/index.ts",
    "dev:executor": "tsx watch src/executor/index.ts",
    "dev:executor2": "EXECUTOR_PORT=3301 INSTANCE_ID=executor-2 tsx watch src/executor/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "PORT=3002 tsx watch src/api/index.ts",
    "start": "concurrently -n sim,api,scanner,executor \"tsx src/cloud-sim/index.ts\" \"tsx src/api/index.ts\" \"tsx src/scanner/index.ts\" \"tsx src/executor/index.ts\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
