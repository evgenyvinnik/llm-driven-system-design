{
  "name": "freight-quote-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Freight quote service: a deadline-bounded quote endpoint over slow dependencies (hedging, breakers, single-flight, load shedding), firm vs indicative quotes, and an event-driven side (outbox, Valkey Streams, async firm completion, signed webhooks, analytics projection with replay)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,deps,completer,projector,receiver -c blue,yellow,magenta,green,cyan \"npm run dev:api\" \"npm run dev:deps\" \"npm run dev:completer\" \"npm run dev:projector\" \"npm run dev:receiver\"",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "PORT=3002 tsx watch src/api/index.ts",
    "dev:deps": "tsx watch src/deps/index.ts",
    "dev:completer": "tsx watch src/completer/index.ts",
    "dev:worker1": "COMPLETER_CONSUMER=completer-1 tsx watch src/completer/index.ts",
    "dev:worker2": "COMPLETER_CONSUMER=completer-2 COMPLETER_PORT=3013 tsx watch src/completer/index.ts",
    "dev:projector": "tsx watch src/projector/index.ts",
    "dev:receiver": "tsx watch src/receiver/index.ts",
    "start": "concurrently -n api,deps,completer,projector,receiver \"tsx src/api/index.ts\" \"tsx src/deps/index.ts\" \"tsx src/completer/index.ts\" \"tsx src/projector/index.ts\" \"tsx src/receiver/index.ts\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "replay": "tsx src/projector/replay.ts",
    "load": "tsx src/scripts/load.ts",
    "practice": "PRACTICE_TARGET=attempt vitest run src/practice",
    "practice:watch": "PRACTICE_TARGET=attempt vitest src/practice",
    "practice:reset": "tsx src/practice/reset.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "ioredis": "^6.0.0",
    "opossum": "^8.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
