{
  "name": "ci-cd-platform-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CI/CD platform: signed webhook intake deduplicated by delivery id, immutable runs pinned to a commit and workflow SHA, dependency-graph scheduling with readiness decided in the completion transaction, runners with leases and fencing tokens, non-idempotent steps that go to needs_attention instead of retrying, scoped encrypted secrets, resumable SSE logs archived to MinIO, artifacts and attempt-numbered re-runs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,sched,runners -c blue,cyan,yellow \"npm run dev:api\" \"npm run dev:scheduler\" \"npm run dev:runners\"",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "PORT=3002 tsx watch src/api/index.ts",
    "dev:scheduler": "tsx watch src/scheduler/index.ts",
    "dev:runners": "tsx src/runner/supervisor.ts",
    "dev:runner1": "RUNNER_NAME=runner-1 RUNNER_LABELS=linux,x64 RUNNER_PORT=3101 tsx src/runner/index.ts",
    "dev:runner2": "RUNNER_NAME=runner-2 RUNNER_LABELS=linux,x64,deploy RUNNER_PORT=3102 tsx src/runner/index.ts",
    "start": "concurrently -n api,sched,runners \"tsx src/api/index.ts\" \"tsx src/scheduler/index.ts\" \"tsx src/runner/supervisor.ts\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "demo:story": "tsx src/demo/story.ts",
    "load:burst": "tsx src/demo/burst.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "ioredis": "^5.8.2",
    "minio": "^8.0.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
