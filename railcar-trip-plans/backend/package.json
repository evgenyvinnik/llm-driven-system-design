{
  "name": "railcar-trip-plans-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Railcar trip plans and ETAs: an event-driven backend with a PostgreSQL event store used as the outbox, Valkey Streams partitioned by car and train, idempotent consumers, a replanning process manager and a dwell-based ETA model",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,relay,state,eta,exc,notify,replan -c blue,gray,magenta,green,yellow,cyan,red \"npm run dev:api\" \"npm run dev:relay\" \"npm run dev:car-state\" \"npm run dev:eta\" \"npm run dev:exceptions\" \"npm run dev:notifier\" \"npm run dev:replanner\"",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:relay": "tsx watch src/relay/index.ts",
    "dev:car-state": "tsx watch src/consumers/car-state/index.ts",
    "dev:eta": "tsx watch src/consumers/eta/index.ts",
    "dev:exceptions": "tsx watch src/consumers/exceptions/index.ts",
    "dev:notifier": "tsx watch src/consumers/notifier/index.ts",
    "dev:replanner": "tsx watch src/replanner/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "PORT=3002 tsx watch src/api/index.ts",
    "start": "concurrently -n api,relay,state,eta,exc,notify,replan \"tsx src/api/index.ts\" \"tsx src/relay/index.ts\" \"tsx src/consumers/car-state/index.ts\" \"tsx src/consumers/eta/index.ts\" \"tsx src/consumers/exceptions/index.ts\" \"tsx src/consumers/notifier/index.ts\" \"tsx src/replanner/index.ts\"",
    "simulate": "tsx src/simulator/index.ts",
    "simulate:fast": "tsx src/simulator/index.ts --speed 4800",
    "replay": "tsx src/projections/replay.ts",
    "relay:republish": "tsx src/relay/republish.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "INTEGRATION=1 vitest run src/integration",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
