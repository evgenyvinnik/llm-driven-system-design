{
  "name": "file-system-backend",
  "version": "1.0.0",
  "private": true,
  "description": "File system practice: a four-level in-memory file store, a PostgreSQL namespace service, and a timed practice runner",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api/index.ts",
    "dev:memory": "FS_STORE=memory tsx watch src/api/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "PORT=3002 tsx watch src/api/index.ts",
    "dev:server3": "PORT=3003 tsx watch src/api/index.ts",
    "start": "tsx src/api/index.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "practice": "tsx src/practice/cli.ts",
    "dedup": "tsx src/fs/dedup-cli.ts",
    "bench": "LOG_LEVEL=warn tsx src/store/bench.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "FS_STORE=postgres vitest run --no-file-parallelism src/fs/tests src/store",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
