{
  "name": "prompt-playground-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Prompt playground: versioned prompts, streamed runs against a mock model, presets, and sharing",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,executor,model -c blue,magenta,green \"npm run dev:api\" \"npm run dev:executor\" \"npm run dev:model\"",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:executor": "tsx watch src/executor/index.ts",
    "dev:model": "tsx watch src/model/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "PORT=3002 tsx watch src/api/index.ts",
    "dev:server3": "PORT=3003 tsx watch src/api/index.ts",
    "dev:executor2": "EXECUTOR_ID=executor-2 EXECUTOR_PORT=3202 tsx watch src/executor/index.ts",
    "start": "concurrently -k -n api,executor,model \"tsx src/api/index.ts\" \"tsx src/executor/index.ts\" \"tsx src/model/index.ts\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "opossum": "^8.4.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/opossum": "^8.1.8",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
