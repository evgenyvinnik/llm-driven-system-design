{
  "name": "llm-chat-analytics-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Chat product analytics: event generator, Kafka ingest with dedup and watermarks, ClickHouse rollups, query API and export worker",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ingest,exporter,generator -c blue,magenta,yellow,green \"npm run dev:api\" \"npm run dev:ingest\" \"npm run dev:exporter\" \"npm run generate:live\"",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:ingest": "tsx watch src/ingest/index.ts",
    "dev:exporter": "tsx watch src/exporter/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "PORT=3002 tsx watch src/api/index.ts",
    "dev:server3": "PORT=3003 tsx watch src/api/index.ts",
    "dev:ingest2": "INGEST_PORT=3111 tsx watch src/ingest/index.ts",
    "start": "concurrently -k -n api,ingest,exporter,generator \"tsx src/api/index.ts\" \"tsx src/ingest/index.ts\" \"tsx src/exporter/index.ts\" \"tsx src/generator/index.ts live\"",
    "generate": "tsx src/generator/index.ts",
    "generate:live": "tsx src/generator/index.ts live",
    "generate:late": "tsx src/generator/index.ts late",
    "generate:dupes": "tsx src/generator/index.ts dupes",
    "rollups:rebuild": "tsx src/db/rebuild-rollups.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@clickhouse/client": "^1.8.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "kafkajs": "^2.2.4",
    "luxon": "^3.5.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
