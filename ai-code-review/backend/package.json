{
  "name": "ai-code-review-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Corrected AI code review: fixture Git host with compare-and-swap reviews, signed webhooks, durable SHA-bound review runs, a deliberately gullible mock model over SSE, a deterministic policy gate, least-privilege agent tools, a separate poster, modes with evaluation-gated promotion, a hash-chained audit log and a human escalation queue",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,work,post,model,host -c blue,yellow,green,magenta,cyan \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:poster\" \"npm run dev:model\" \"npm run dev:githost\"",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "PORT=3002 tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:worker1": "WORKER_PORT=3101 WORKER_ID=worker-1 tsx watch src/worker/index.ts",
    "dev:worker2": "WORKER_PORT=3102 WORKER_ID=worker-2 tsx watch src/worker/index.ts",
    "dev:poster": "tsx watch src/poster/index.ts",
    "dev:model": "tsx watch src/model/index.ts",
    "dev:githost": "tsx watch src/githost/index.ts",
    "start": "concurrently -n api,work,post,model,host \"tsx src/api/index.ts\" \"tsx src/worker/index.ts\" \"tsx src/poster/index.ts\" \"tsx src/model/index.ts\" \"tsx src/githost/index.ts\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "corpus:build": "tsx src/evaluation/build-corpus.ts",
    "demo:story": "tsx src/demo/story.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "ioredis": "^5.8.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
