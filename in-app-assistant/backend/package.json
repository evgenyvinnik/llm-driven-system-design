{
  "name": "in-app-assistant-backend",
  "version": "1.0.0",
  "private": true,
  "description": "In-app assistant: agent loop orchestrator, policy-checked tools, hybrid retrieval and a mock model that speaks the Messages API",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,model,indexer -c blue,green,magenta \"npm run dev:api\" \"npm run dev:model\" \"npm run dev:indexer\"",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:model": "tsx watch src/model/index.ts",
    "dev:indexer": "tsx watch src/indexer/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "PORT=3002 tsx watch src/api/index.ts",
    "start": "concurrently -n api,model,indexer \"tsx src/api/index.ts\" \"tsx src/model/index.ts\" \"tsx src/indexer/index.ts\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "index:backfill": "tsx src/indexer/backfill.ts",
    "eval": "tsx src/eval/run-eval.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pgvector": "^0.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
