{
  "name": "llm-inference-api-backend",
  "version": "1.0.0",
  "private": true,
  "description": "LLM inference API: API-key gateway with cost-based admission, fair batching dispatcher, bounded-load consistent-hash routing, and three continuous-batching mock model backends",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n gw,disp,b1,b2,b3 -c blue,green,magenta,yellow,cyan \"npm run dev:gateway\" \"npm run dev:dispatcher\" \"npm run dev:backend1\" \"npm run dev:backend2\" \"npm run dev:backend3\"",
    "dev:gateway": "tsx watch src/gateway/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/gateway/index.ts",
    "dev:dispatcher": "tsx watch src/dispatcher/index.ts",
    "dev:dispatcher2": "DISPATCHER_PORT=3110 tsx watch src/dispatcher/index.ts",
    "dev:backend1": "BACKEND_ID=b1 BACKEND_PORT=3101 tsx watch src/backend/index.ts",
    "dev:backend2": "BACKEND_ID=b2 BACKEND_PORT=3102 tsx watch src/backend/index.ts",
    "dev:backend3": "BACKEND_ID=b3 BACKEND_PORT=3103 tsx watch src/backend/index.ts",
    "start": "concurrently -n gw,disp,b1,b2,b3 \"tsx src/gateway/index.ts\" \"tsx src/dispatcher/index.ts\" \"BACKEND_ID=b1 BACKEND_PORT=3101 tsx src/backend/index.ts\" \"BACKEND_ID=b2 BACKEND_PORT=3102 tsx src/backend/index.ts\" \"BACKEND_ID=b3 BACKEND_PORT=3103 tsx src/backend/index.ts\"",
    "load": "tsx src/load/index.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "ioredis": "^5.8.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
