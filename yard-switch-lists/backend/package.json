{
  "name": "yard-switch-lists-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Yard switch lists: durable planner jobs, independent plan validator, versioned plans with optimistic publish, stable replanning, yardmaster overrides, holds feed, crew execution feedback and a seeded yard simulator",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,worker,sim -c blue,magenta,cyan \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:simulator\"",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:simulator": "tsx watch src/simulator/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "PORT=3002 tsx watch src/api/index.ts",
    "dev:worker1": "WORKER_PORT=3101 tsx watch src/worker/index.ts",
    "dev:worker2": "WORKER_PORT=3102 tsx watch src/worker/index.ts",
    "start": "concurrently -n api,worker,sim \"tsx src/api/index.ts\" \"tsx src/worker/index.ts\" \"tsx src/simulator/index.ts\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:plain": "SEED_PLAIN=1 tsx src/db/seed.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "ioredis": "^5.8.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
