{
  "name": "railcar-health-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Railcar health: idempotent wayside detector ingest, a stream analyzer that trends bearing temperatures across detectors, risk alerts with car holds, and a yard inspection workflow",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,analyzer -c blue,magenta \"npm run dev:api\" \"npm run dev:analyzer\"",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:analyzer": "tsx watch src/analyzer/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "PORT=3002 tsx watch src/api/index.ts",
    "dev:worker1": "ANALYZER_CONSUMER=analyzer-1 tsx watch src/analyzer/index.ts",
    "dev:worker2": "ANALYZER_CONSUMER=analyzer-2 tsx watch src/analyzer/index.ts",
    "start": "concurrently -n api,analyzer \"tsx src/api/index.ts\" \"tsx src/analyzer/index.ts\"",
    "simulate": "tsx src/simulator/index.ts",
    "simulate:fast": "tsx src/simulator/index.ts --speed 240",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
