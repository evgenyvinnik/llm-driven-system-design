{
  "name": "railcar-health-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Railcar health, event-driven: an event store for alert cases and car component history, a transactional outbox relayed to Valkey Streams, idempotent consumer groups (analyzer, notifier, work-order integration, projections), a process manager with durable timers, a dead-letter stream and replayable projections",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,analyzer,workers -c blue,magenta,green \"npm run dev:api\" \"npm run dev:analyzer\" \"npm run dev:workers\"",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:analyzer": "tsx watch src/analyzer/index.ts",
    "dev:workers": "tsx watch src/workers/index.ts",
    "dev:relay": "WORKER_ROLES=relay tsx watch src/workers/index.ts",
    "dev:projections": "WORKER_ROLES=projections WORKERS_PORT=3012 tsx watch src/workers/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "PORT=3002 tsx watch src/api/index.ts",
    "dev:worker1": "CONSUMER_NAME=analyzer-1 tsx watch src/analyzer/index.ts",
    "dev:worker2": "CONSUMER_NAME=analyzer-2 ANALYZER_PORT=3013 tsx watch src/analyzer/index.ts",
    "start": "concurrently -n api,analyzer,workers \"tsx src/api/index.ts\" \"tsx src/analyzer/index.ts\" \"tsx src/workers/index.ts\"",
    "simulate": "tsx src/simulator/index.ts",
    "simulate:fast": "tsx src/simulator/index.ts --speed 240",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "replay": "tsx src/replay/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "demo:component-swap": "tsx src/simulator/component-swap.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
