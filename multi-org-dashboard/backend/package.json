{
  "name": "multi-org-dashboard-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-org console API: per-org roles, a permission manifest, feature flags, audited admin actions, background exports",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker -c blue,magenta \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:server1": "PORT=3001 tsx watch src/api/index.ts",
    "dev:server2": "PORT=3002 tsx watch src/api/index.ts",
    "dev:server3": "PORT=3003 tsx watch src/api/index.ts",
    "dev:worker2": "WORKER_ID=worker-2 tsx watch src/worker/index.ts",
    "start": "concurrently -k -n api,worker \"tsx src/api/index.ts\" \"tsx src/worker/index.ts\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
