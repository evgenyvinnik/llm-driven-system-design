{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // tsc -b only type-checks vite.config.ts (Vite bundles it itself). A referenced project
    // can't use noEmit, so emit declarations only, outside the source tree; otherwise every
    // build left vite.config.js and vite.config.d.ts next to the source.
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
