# Environment
NODE_ENV=development

# Server
PORT=3001

# Database
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/job_scheduler

# Redis
REDIS_URL=redis://localhost:6379

# Scheduler
SCHEDULER_INSTANCE_ID=scheduler-1
LEADER_LOCK_TTL=30
SCAN_INTERVAL_MS=1000
# How late a recurring slot may be and still count as on time (must exceed failover time)
MISFIRE_GRACE_MS=60000
REAPER_INTERVAL_MS=5000

# Worker
WORKER_ID=worker-1
MAX_CONCURRENT_JOBS=5
POLL_INTERVAL_MS=500
# A worker that stops renewing loses its execution after this long (renewed every third)
LEASE_DURATION_MS=30000
SHUTDOWN_GRACE_MS=10000
